<Window x:Class="PracticeC_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LineSegment - Работа с отрезками" Height="550" Width="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Работа с отрезками на числовой прямой (LineSegment)" 
                   FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="5" TextWrapping="Wrap"/>

        <!-- Панель ввода -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Начало (X):" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtX" Text="0" Margin="5" Width="120" HorizontalAlignment="Left"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Конец (Y):" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtY" Text="1" Margin="5" Width="120" HorizontalAlignment="Left"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <Button x:Name="btnCreate" Content="Создать отрезок" Width="120" Height="30" Margin="5" Click="BtnCreate_Click"/>
                    <Button x:Name="btnDefault" Content="По умолчанию" Width="120" Height="30" Margin="5" Click="BtnDefault_Click"/>
                    <Button x:Name="btnCopy" Content="Копировать" Width="120" Height="30" Margin="5" Click="BtnCopy_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" x:Name="txtCurrentSegment" Text="Текущий отрезок: не создан" 
                           FontWeight="Bold" Foreground="Blue" Margin="5" TextAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Операции -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" x:Name="btnLength" Content="Вычислить длину (!segment)" 
                        Width="280" Height="35" Margin="5" HorizontalAlignment="Left" Click="BtnLength_Click"/>
                <TextBlock Grid.Row="0" x:Name="txtLength" Margin="290,10,10,10" VerticalAlignment="Center"/>

                <Button Grid.Row="1" x:Name="btnIncrement" Content="Увеличить координаты на 1 (segment++)" 
                        Width="280" Height="35" Margin="5" HorizontalAlignment="Left" Click="BtnIncrement_Click"/>

                <Button Grid.Row="2" x:Name="btnAddInt" Content="Прибавить число к отрезку (segment + n)" 
                        Width="280" Height="35" Margin="5" HorizontalAlignment="Left" Click="BtnAddInt_Click"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="290,5,10,5">
                    <TextBlock Text="Число:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtAddValue" Text="5" Width="80" Margin="5"/>
                </StackPanel>

                <Button Grid.Row="3" x:Name="btnCompare" Content="Проверить попадание числа в отрезок (segment &lt; n или segment &gt; n)" 
                        Width="400" Height="35" Margin="5" HorizontalAlignment="Left" Click="BtnCompare_Click"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="410,5,10,5">
                    <TextBlock Text="Число:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtCompareValue" Text="5" Width="80" Margin="5"/>
                </StackPanel>

                <Button Grid.Row="4" x:Name="btnCast" Content="Проверить приведение типов ((int) и (double))" 
                        Width="300" Height="35" Margin="5" HorizontalAlignment="Left" Click="BtnCast_Click"/>
                <TextBlock Grid.Row="4" x:Name="txtCast" Margin="310,10,10,10" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Button Grid.Row="5" x:Name="btnContains" Content="Проверить попадание числа в отрезок (метод Contains)" 
                        Width="350" Height="35" Margin="5" HorizontalAlignment="Left" Click="BtnContains_Click"/>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="360,5,10,5">
                    <TextBlock Text="Число:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtContainsValue" Text="3" Width="80" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Лог операций -->
        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Лог операций:" FontWeight="Bold" Margin="5"/>
                <ListBox Grid.Row="1" x:Name="lstLog" Margin="5" Height="120"/>
            </Grid>
        </Border>
    </Grid>
</Window>